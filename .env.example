# Copy to .env and fill in your own values:   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# Supabase Dashboard -> Project Settings -> API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLIC key: "anon" (legacy, starts with eyJ...) or "publishable" (starts with sb_publishable_...).
# NEVER put the service_role / secret key here: it bypasses all security.
SUPABASE_KEY=your-anon-or-publishable-key

PORT=8000
